{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"paths": {
			"@liuxuedeng/agent-core-agent": ["../agent/dist/index.d.ts"],
			"@liuxuedeng/agent-core-agent/*": ["../agent/dist/*.d.ts"],
			"@liuxuedeng/agent-core-ai": ["../ai/dist/index.d.ts"],
			"@liuxuedeng/agent-core-ai/*": ["../ai/dist/*.d.ts", "../ai/dist/providers/*.d.ts"],
			"@liuxuedeng/agent-core-tui": ["../tui/dist/index.d.ts"],
			"@liuxuedeng/agent-core-tui/*": ["../tui/dist/*.d.ts", "../tui/dist/components/*.d.ts"]
		},
		"rootDir": "./src"
	},
	"include": ["src/**/*.ts", "src/**/*.d.ts"],
	"exclude": ["node_modules", "dist", "src/client", "src/experimental", "src/cli/experimental"]
}
