{
	"name": "@liuxuedeng/agent-core-agent",
	"version": "0.1.0-alpha.1",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./harness/context": {
			"types": "./dist/harness/context.d.ts",
			"import": "./dist/harness/context.js"
		},
		"./harness/env/nodejs": {
			"types": "./dist/harness/env/nodejs.d.ts",
			"import": "./dist/harness/env/nodejs.js"
		},
		"./harness/runtime/reducer": {
			"types": "./dist/harness/runtime/reducer.d.ts",
			"import": "./dist/harness/runtime/reducer.js"
		},
		"./harness/session": {
			"types": "./dist/harness/session/index.d.ts",
			"import": "./dist/harness/session/index.js"
		},
		"./harness/session/testing": {
			"types": "./dist/harness/session/testing/index.d.ts",
			"import": "./dist/harness/session/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"generate-telemetry-docs": "node scripts/generate-telemetry-docs.ts",
		"check:telemetry-docs": "node scripts/generate-telemetry-docs.ts --check",
		"build": "tsgo -p tsconfig.build.json",
		"bench:session:timing": "vitest bench --config vitest.benchmark.config.ts",
		"bench:session:memory": "tsx --tsconfig benchmark/tsconfig.json benchmark/session/loaded-footprint.ts",
		"bench:session:allocations": "tsx --tsconfig benchmark/tsconfig.json benchmark/session/allocation-profile.ts",
		"test": "vitest --run",
		"test:harness": "vitest --run --config vitest.harness.config.ts",
		"test:session:conformance": "vitest --run --config vitest.harness.config.ts test/harness/memory-conformance.test.ts",
		"coverage:harness": "vitest --run --config vitest.harness.config.ts --coverage",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@liuxuedeng/agent-core-chord": "^0.1.0-alpha.1",
		"@liuxuedeng/agent-core-ai": "^0.1.0-alpha.1",
		"@liuxuedeng/agent-core-telemetry": "^0.1.0-alpha.1",
		"diff": "8.0.4",
		"ignore": "7.0.5",
		"typebox": "1.3.7",
		"yaml": "2.9.0"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "LiuXD1011",
	"contributors": [
		"Mario Zechner (original Pi)"
	],
	"license": "MIT",
	"homepage": "https://github.com/LiuXD1011/agent-core#readme",
	"bugs": {
		"url": "https://github.com/LiuXD1011/agent-core/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LiuXD1011/agent-core.git",
		"directory": "packages/agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "22.19.19",
		"@vitest/coverage-v8": "4.1.9",
		"typescript": "5.9.3",
		"vitest": "4.1.9"
	}
}
