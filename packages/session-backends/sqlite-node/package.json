{
	"name": "@liuxuedeng/agent-core-sqlite-node",
	"version": "0.1.0-alpha.1",
	"description": "Node sqlite session backend for @liuxuedeng/agent-core-agent sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsgo -p tsconfig.build.json && node scripts/copy-migrations.mjs",
		"bench:session:timing": "vitest bench --config vitest.benchmark.config.ts",
		"test": "vitest --run",
		"coverage": "vitest --run --coverage",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"author": "LiuXD1011",
	"contributors": [
		"Earendil Works (original Pi)"
	],
	"license": "MIT",
	"homepage": "https://github.com/LiuXD1011/agent-core#readme",
	"bugs": {
		"url": "https://github.com/LiuXD1011/agent-core/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/LiuXD1011/agent-core.git",
		"directory": "packages/session-backends/sqlite-node"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@liuxuedeng/agent-core-ai": "^0.1.0-alpha.1",
		"@liuxuedeng/agent-core-agent": "^0.1.0-alpha.1"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.9",
		"vitest": "4.1.9"
	}
}
