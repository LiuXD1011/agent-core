{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"@liuxuedeng/pi-core-chord": ["./packages/chord/src/index.ts"],
			"@liuxuedeng/pi-core-chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@liuxuedeng/pi-core-chord/context": ["./packages/chord/src/context/index.ts"],
			"@liuxuedeng/pi-core-chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@liuxuedeng/pi-core-chord/node": ["./packages/chord/src/node.ts"],
			"@liuxuedeng/pi-core-telemetry": ["./packages/telemetry/src/index.ts"],
			"@liuxuedeng/pi-core-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@liuxuedeng/pi-core-ai": ["./packages/ai/src/index.ts"],
			"@liuxuedeng/pi-core-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@liuxuedeng/pi-core-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@liuxuedeng/pi-core-ai/dist/*": ["./packages/ai/src/*"],
			"@liuxuedeng/pi-core-agent": ["./packages/agent/src/index.ts"],
			"@liuxuedeng/pi-core-agent/harness/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@liuxuedeng/pi-core-agent/node": ["./packages/agent/src/node.ts"],
			"@liuxuedeng/pi-core-agent/*": [
				"./packages/agent/src/*.ts",
				"./packages/agent/src/*/index.ts",
				"./packages/agent/src/*"
			],
			"@liuxuedeng/pi-core-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@liuxuedeng/pi-core": ["./packages/coding-agent/src/index.ts"],
			"@liuxuedeng/pi-core/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@liuxuedeng/pi-core/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@liuxuedeng/pi-core/*": ["./packages/coding-agent/src/*"],
			"@liuxuedeng/pi-core-protocol": ["./packages/protocol/src/index.ts"],
			"@liuxuedeng/pi-core-protocol/*": ["./packages/protocol/src/*"],
			"@liuxuedeng/pi-core-client": ["./packages/client/src/index.ts"],
			"@liuxuedeng/pi-core-client/unix": ["./packages/client/src/unix.ts"],
			"@liuxuedeng/pi-core-client/*": ["./packages/client/src/*"],
			"@liuxuedeng/pi-core-server": ["./packages/server/src/index.ts"],
			"@liuxuedeng/pi-core-server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@liuxuedeng/pi-core-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@liuxuedeng/pi-core-tui": ["./packages/tui/src/index.ts"],
			"@liuxuedeng/pi-core-tui/*": ["./packages/tui/src/*"],
			"@earendil-works/pi-agent-old": ["./packages/agent-old/src/index.ts"],
			"@earendil-works/pi-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/session-backends/*/src/**/*", "packages/session-backends/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
