{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "*": [
        "./*"
      ],
      "@liuxuedeng/agent-core-ai": [
        "./packages/ai/src/index.ts"
      ],
      "@liuxuedeng/agent-core-ai/oauth": [
        "./packages/ai/src/oauth.ts"
      ],
      "@liuxuedeng/agent-core-ai/*": [
        "./packages/ai/src/*.ts",
        "./packages/ai/src/providers/*.ts"
      ],
      "@liuxuedeng/agent-core-ai/dist/*": [
        "./packages/ai/src/*"
      ],
      "@liuxuedeng/agent-core-agent": [
        "./packages/agent/src/index.ts"
      ],
      "@liuxuedeng/agent-core-agent/*": [
        "./packages/agent/src/*.ts",
        "./packages/agent/src/*/index.ts",
        "./packages/agent/src/*"
      ],
      "@liuxuedeng/agent-core": [
        "./packages/agent-app/src/index.ts"
      ],
      "@liuxuedeng/agent-core/*": [
        "./packages/agent-app/src/*"
      ],
      "typebox": [
        "./node_modules/typebox"
      ],
      "@liuxuedeng/agent-core-tui": [
        "./packages/tui/src/index.ts"
      ],
      "@liuxuedeng/agent-core-tui/*": [
        "./packages/tui/src/*"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "packages/agent-app/examples/**/*"
  ],
  "exclude": [
    "**/dist/**"
  ]
}
